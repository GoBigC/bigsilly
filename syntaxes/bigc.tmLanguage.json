{
	"$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
	"name": "bigc",
	"patterns": [
		{
			"include": "#comments"
		},
		{
			"include": "#keywords"
		},
		{
			"include": "#types"
		},
		{
			"include": "#strings-single"
		},
		{
			"include": "#constants"
		},
		{
			"include": "#numbers"
		},
		{
			"include": "#functions"
		},
		{
			"include": "#variables"
		},
		{
			"include": "#operators"
		},
		{
			"include": "#punctuation"
		}
	],
	"repository": {
		"comments": {
			"patterns": [
				{
					"name": "comment.line.double-slash.bigc",
					"match": "//.*$"
				},
				{
					"name": "comment.block.bigc",
					"begin": "/\\*",
					"end": "\\*/"
				}
			]
		},
		"keywords": {
			"patterns": [
				{
					"name": "keyword.control.bigc",
					"match": "\\b(if|while|return|else)\\b"
				}
			]
		},
		"types": {
			"patterns": [
				{
					"name": "storage.type.bigc",
					"match": "\\b(int|float|char|void|bool)\\b"
				}
			]
		},
		"strings-single": {
			"name": "string.quoted.single.bigc",
			"begin": "'",
			"end": "'",
			"patterns": [
				{
					"name": "constant.character.escape.bigc",
					"match": "\\\\."
				}
			]
		},
		"constants": {
			"patterns": [
				{
					"name": "constant.language.boolean.bigc",
					"match": "\\b(true|false)\\b"
				}
			]
		},
		"numbers": {
			"patterns": [
				{
					"name": "constant.numeric.integer.bigc",
					"match": "\\b[0-9]+\\b"
				},
				{
					"name": "constant.numeric.float.bigc",
					"match": "\\b[0-9]+\\.[0-9]+\\b"
				}
			]
		},
		"functions": {
			"patterns": [
				{
					"name": "entity.name.function.bigc",
					"match": "\\b[a-zA-Z_][a-zA-Z0-9_]*(?=\\s*\\()"
				}
			]
		},
		"variables": {
			"patterns": [
				{
					"name": "variable.name.bigc",
					"match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\b"
				}
			]
		},
		"operators": {
			"patterns": [
				{
					"name": "keyword.operator.arithmetic.bigc",
					"match": "[+\\-*/]"
				},
				{
					"name": "keyword.operator.comparison.bigc",
					"match": "(==|!=|<=|>=|<|>)"
				},
				{
					"name": "keyword.operator.logical.bigc",
					"match": "(\\|\\||&&|!)"
				},
				{
					"name": "keyword.operator.assignment.bigc",
					"match": "="
				}
			]
		},
		"punctuation": {
			"patterns": [
				{
					"name": "punctuation.brackets.bigc",
					"match": "[\\[\\]{}()]"
				},
				{
					"name": "punctuation.separator.bigc",
					"match": "[,;]"
				}
			]
		}
	},
	"scopeName": "source.bigc"
}